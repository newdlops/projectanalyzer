{
  "name": "function-analysis",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1074",
  "publisher": "newdlops",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newdlops/projectanalyzer.git"
  },
  "homepage": "https://github.com/newdlops/projectanalyzer#readme",
  "bugs": {
    "url": "https://github.com/newdlops/projectanalyzer/issues"
  },
  "icon": "media/project-analyzer-icon.png",
  "preview": true,
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "code flow",
    "code visualization",
    "control flow",
    "call graph",
    "static analysis",
    "codebase navigation",
    "typescript",
    "python",
    "java",
    "functional programming"
  ],
  "galleryBanner": {
    "color": "#111B3C",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:projectAnalyzer.explorerView",
    "onCommand:projectAnalyzer.visualizeCurrentFunction",
    "onCommand:projectAnalyzer.openModuleFlow"
  ],
  "main": "./out/extension/activate.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectAnalyzer",
          "title": "%viewContainer.title%",
          "icon": "media/project-analyzer.svg"
        }
      ]
    },
    "views": {
      "projectAnalyzer": [
        {
          "id": "projectAnalyzer.explorerView",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "projectAnalyzer.visualizeCurrentFunction",
        "title": "%command.visualizeCurrentFunction%",
        "category": "%command.category%"
      },
      {
        "command": "projectAnalyzer.openModuleFlow",
        "title": "%command.openModuleFlow%",
        "category": "%command.category%",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "projectAnalyzer.visualizeCurrentFunction",
          "when": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|python|java|fsharp|ocaml|elixir)$/",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "projectAnalyzer.openModuleFlow",
          "when": "view == projectAnalyzer.explorerView",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "projectAnalyzer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enabled.description%"
        },
        "projectAnalyzer.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoAnalyze.description%"
        },
        "projectAnalyzer.uiLanguage": {
          "type": "string",
          "enum": ["auto", "ko", "en"],
          "enumDescriptions": [
            "%configuration.uiLanguage.auto%",
            "%configuration.uiLanguage.ko%",
            "%configuration.uiLanguage.en%"
          ],
          "default": "auto",
          "description": "%configuration.uiLanguage.description%"
        },
        "projectAnalyzer.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.{ts,tsx,js,jsx,py,java,fs,fsx,ml,mli,ex,exs}"
          ],
          "description": "%configuration.include.description%"
        },
        "projectAnalyzer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/coverage/**",
            "**/.venv/**",
            "**/venv/**"
          ],
          "description": "%configuration.exclude.description%"
        },
        "projectAnalyzer.maxFileSizeKb": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "%configuration.maxFileSizeKb.description%"
        },
        "projectAnalyzer.maxRenderedNodes": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 2000,
          "description": "%configuration.maxRenderedNodes.description%"
        },
        "projectAnalyzer.defaultDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "%configuration.defaultDepth.description%"
        },
        "projectAnalyzer.codeFlow.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 12,
          "description": "%configuration.codeFlow.maxDepth.description%"
        },
        "projectAnalyzer.codeFlow.maxSteps": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 200,
          "description": "%configuration.codeFlow.maxSteps.description%"
        },
        "projectAnalyzer.codeFlow.maxLogicBlocks": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 300,
          "description": "%configuration.codeFlow.maxLogicBlocks.description%"
        },
        "projectAnalyzer.includeExternalDependencies": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.includeExternalDependencies.description%"
        },
        "projectAnalyzer.showUnresolvedEdges": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showUnresolvedEdges.description%"
        },
        "projectAnalyzer.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.cache.enabled.description%"
        },
        "projectAnalyzer.cache.maxSizeMb": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "%configuration.cache.maxSizeMb.description%"
        }
      }
    }
  },
  "dependencies": {
    "@lezer/java": "^1.1.3",
    "@lezer/python": "^1.1.19",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "engine:build": "cargo build --manifest-path engine/analyzer/Cargo.toml",
    "engine:build:release": "cargo build --release --manifest-path engine/analyzer/Cargo.toml",
    "engine:stage": "node scripts/stage-runtime-engine.mjs",
    "engine:test": "cargo test --manifest-path engine/analyzer/Cargo.toml",
    "dev:prepare": "npm run engine:build && npm run compile",
    "compile": "node scripts/clean-output.mjs && tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "check": "tsc -p ./tsconfig.json --noEmit",
    "test:package": "node --test scripts/*.test.mjs",
    "test": "npm run engine:test && npm run compile && node --test out/test/unit/*.test.js && npm run test:package",
    "package:check": "node scripts/check-vsix-package.mjs",
    "package:vsix": "node scripts/package-extension.mjs",
    "release:check": "node scripts/check-release-metadata.mjs",
    "vscode:prepublish": "npm run engine:build:release && npm run engine:stage && npm run compile"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.92.0"
  }
}
