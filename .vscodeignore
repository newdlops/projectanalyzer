*.vsix

# Keep the editable Marketplace artwork in the repository, but ship only its PNG.
media/project-analyzer-marketplace.svg

# TypeScript and Rust sources are compiled before VSIX packaging
src/**
!package.nls.json
!package.nls.ko.json
scripts/**
engine/analyzer/src/**
engine/analyzer/target/**
engine/analyzer/Cargo.toml
engine/analyzer/Cargo.lock
out/test/**
out/**/*.map

# Prepublish bundles these same-directory helpers into their public index.
# Keep the watchdog as its separate, source-free child-process entrypoint.
out/llm/functionNarratives/localAcceleration.js
out/llm/functionNarratives/localInput.js
out/llm/functionNarratives/localPrompt.js
out/llm/functionNarratives/localProvider.js
out/llm/functionNarratives/localResponse.js
out/llm/functionNarratives/localServer.js
out/llm/functionNarratives/localWire.js
out/llm/functionNarratives/responseSchema.js

# Dormant feature modules are not reached by the extension entrypoint. Keep their
# editable sources/tests; the runtime-closure checker catches future wiring.
out/application/guidedTour/**
out/application/projectOverview/**
out/application/projectReadingGuide/**
out/insights/guidedTour/**
out/insights/projectOverview/**
out/insights/projectReadingGuide/**
out/shared/projectLearningJourney/**
out/shared/frameworkBehavior.js
out/webview/explorerFrameworkTree.js
out/webview/explorerFunctionCallTree.js
out/webview/explorerFunctionFlows.js
out/webview/explorerFunctionInventory.js
out/webview/explorerVirtualTree.js

# The fallback parser only needs TypeScript's self-contained runtime module.
node_modules/typescript/README.md
node_modules/typescript/SECURITY.md
node_modules/typescript/bin/**
node_modules/typescript/lib/**/*.d.ts
node_modules/typescript/lib/**/*.map
node_modules/typescript/lib/*/**
node_modules/typescript/lib/typesMap.json
node_modules/typescript/lib/_tsc.js
node_modules/typescript/lib/_tsserver.js
node_modules/typescript/lib/_typingsInstaller.js
node_modules/typescript/lib/tsc.js
node_modules/typescript/lib/tsserver.js
node_modules/typescript/lib/tsserverlibrary.js
node_modules/typescript/lib/typingsInstaller.js
node_modules/typescript/lib/watchGuard.js

# Python/Java Lezer adapters need only CommonJS runtime modules and manifests.
node_modules/@lezer/**/README.md
node_modules/@lezer/**/CHANGELOG.md
node_modules/@lezer/**/rollup.config.js
node_modules/@lezer/**/src/**
node_modules/@lezer/**/test/**
node_modules/@lezer/**/dist/*.js
node_modules/@lezer/**/dist/*.d.ts
node_modules/@lezer/**/dist/*.d.cts

# Kotlin needs the Node CommonJS ANTLR runtime; omit browser builds, maps and declarations.
node_modules/antlr4/README.md
node_modules/antlr4/src/**
node_modules/antlr4/dist/*.map
node_modules/antlr4/dist/*.mjs
node_modules/antlr4/dist/antlr4.web.cjs
